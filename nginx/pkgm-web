# 限速区域
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=1r/s;
limit_req_zone $binary_remote_addr zone=search_limit:10m rate=5r/s;

upstream pkgm-web {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80;
    server_name www.hydraskill.com;

    # Root path - catch all
    location / {
        proxy_pass http://pkgm-web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # auth
    location /api/auth/login {
        proxy_pass http://pkgm-web;
        limit_req zone=login_limit burst=3 nodelay;
    }

    # 其他 /api/ 路由代理
    location /api/ {
        proxy_pass http://pkgm-web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 搜索
    location ~ ^/docs/([^/]+)/api/search {
        set $user $1;
        rewrite ^/docs/[^/]+(/api/search.*) $1?user=$user&$args break;
        proxy_pass http://pkgm-web;
        proxy_set_header X-User-ID $user;
        proxy_set_header Host $host;
        limit_req zone=search_limit burst=10 nodelay;
    }

    # SSE
    location ~ ^/docs/([^/]+)/api/notify {
        set $user $1;
        proxy_pass http://pkgm-web;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # 文档详情：带子路径 → rewrite 为带 path query param 的 URI
    location ~ ^/docs/([^/]+)(/.*)$ {
        set $user $1;
        set $path_info $2;
        rewrite ^ /docs/$user?path=$path_info? last;
    }

    # 用户路径：无子路径（文档列表）
    location ~ ^/docs/([^/]+)$ {
        set $user $1;
        proxy_pass http://pkgm-web;
        proxy_set_header X-User-ID $user;
        proxy_set_header X-User-Path /workspace/project/PKGM/users/$user;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /login { proxy_pass http://pkgm-web; }
    location /register { proxy_pass http://pkgm-web; }
    location /_next/ { proxy_pass http://pkgm-web; }
}

# Catch-all server for any other host
server {
    listen 80 default_server;
    server_name _;
    location / {
        proxy_pass http://pkgm-web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}